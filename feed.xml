      <link>https://111.230.153.15/news/?batch=smart-20261122-211322&amp;cat=finance&amp;event=evt_27aeac4e6eea</link>
      <guid isPermaLink="false">smart-20261122-211322:evt_27aeac4e6eea</guid>
