    <item>
      <title>特斯拉开启推送FSD V15全新可视化UI，大范围推送定于12月</title>
      <link>https://111.230.153.15/news/?batch=smart-20261122-143735&amp;cat=general&amp;event=evt_4aff3f4374bb</link>
      <guid isPermaLink="false">smart-20261122-143735:evt_4aff3f4374bb</guid>
