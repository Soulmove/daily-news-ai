    <item>
      <title>习近平和彭丽媛为来宾举行欢迎宴会</title>
      <link>https://soulmove.github.io/daily-news-ai/?batch=smart-20261119-190807&amp;cat=general&amp;event=evt_539c302507f5</link>
      <guid isPermaLink="false">smart-20261119-190807:evt_539c302507f5</guid>
