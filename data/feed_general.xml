    <item>
      <title>《教材管理条例（征求意见稿）》面向社会公开征求意见</title>
      <link>https://111.230.153.15/news/?batch=smart-20261124-153824&amp;cat=general&amp;event=evt_26797fa94726</link>
      <guid isPermaLink="false">smart-20261124-153824:evt_26797fa94726</guid>
